   "source": [
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "x = np.linspace(-69, 69, 100)\n",
    "y = 1 / (1 + np.exp(-x))\n",
    "\n",
    "plt.plot(x, y)\n",
    "plt.xlabel('x (unbounded)')\n",
    "plt.ylabel('y (probability)')\n",
    "plt.title('Logistic function')\n",
    "plt.grid()\n",
    "\n",
    "plt.show()"
   ]
  },
